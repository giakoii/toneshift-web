# Copy to .env and fill in. Never commit .env.
DB_NAME=toneshift
DB_USERNAME=toneshift
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/toneshift

PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Signing key for access tokens. Generate with: openssl rand -base64 32
JWT_KEY=
# OAuth client id of the Google app whose ID tokens this backend accepts (the 'aud' claim).
GOOGLE_CLIENT_ID=

# SMTP for password reset mail. Dev defaults to a local catcher (MailHog on port 1025).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@toneshift.vn

SERVER_PORT=8080
